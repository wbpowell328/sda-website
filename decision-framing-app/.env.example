# Copy this file to ".env" (no extension prefix) and fill in real values.
# Never commit the real .env file — it is in .gitignore.

# Turso (hosted SQLite) for this app's own data — a NEW/separate database
# from the chatbot's. Sign up free at https://turso.tech.
# For LOCAL DEV ONLY, you can skip Turso entirely and use a local SQLite
# file instead — no account needed:
#   TURSO_DATABASE_URL=file:local.db
#   (leave TURSO_AUTH_TOKEN blank)
TURSO_DATABASE_URL=libsql://your-framing-app-database.turso.io
TURSO_AUTH_TOKEN=your-turso-jwt-token

# Random string used to sign the session cookie. Any long random value works.
COOKIE_SECRET=change-me

# Resend (transactional email) for password-reset links. Sign up at
# https://resend.com. Added in Phase 6 — not required until then.
RESEND_API_KEY=
EMAIL_FROM=

# Base URL of this app, used to build links in password-reset emails.
APP_BASE_URL=http://localhost:3100

# Port the local server listens on. Default 3100 (chatbot uses 3000).
PORT=3100
