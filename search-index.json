---
layout: null
permalink: /search-index.json
---
[
{%- assign book_pages = site.pages | where_exp: "p", "p.layout == 'book'" | sort: "url" -%}
{%- for p in book_pages -%}
{%- assign book_key = p.book_data | default: "bridging_vol1_toc" -%}
{
"book": {{ book_key | jsonify }},
"url": {{ p.url | relative_url | jsonify }},
"title": {{ p.title | jsonify }},
"text": {{ p.content | strip_html | normalize_whitespace | jsonify }}
},
{%- endfor -%}
{%- assign non_book_pages = site.pages | where_exp: "p", "p.layout != 'book'" -%}
{%- assign site_pages = non_book_pages | where_exp: "p", "p.layout != nil" | sort: "url" -%}
{%- for p in site_pages -%}
{
"book": null,
"url": {{ p.url | relative_url | jsonify }},
"title": {{ p.title | jsonify }},
"text": {{ p.content | strip_html | normalize_whitespace | jsonify }}
}{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]
